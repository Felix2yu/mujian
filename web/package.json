{
  "name": "mujian-frontend",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
