    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
