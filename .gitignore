# Dependencies
node_modules/
vendor/
# 统一 pnpm。其他包管理器的锁文件不入库——历史上正是「bun.lock/package-lock
# 与 pnpm-lock 并存」让 CI 猜错过包管理器，这里从约定上杜绝。
package-lock.json
yarn.lock
bun.lock
bun.lockb

# Build
# 全部加 / 锚定：无斜杠的规则会匹配任意层级的同名目录
# （例如裸写 mujian 会命中 cmd/mujian/，把整个入口包判成忽略）
web/dist/
web/.svelte-kit/
/mujian
/mujian-server
/bin/
/dist/
/coverage.out

# 前端内嵌产物：internal/web/dist 由构建脚本生成，仓库里只留 .gitkeep 占位
# （否则 //go:embed all:dist 在未构建前端时直接编译不过）
internal/web/dist/*
!internal/web/dist/.gitkeep

# Data
/data/

# 迁移残留（backend/ 已回根，仅剩未跟踪的本地产物/数据，待人工确认后删除）
/backend/

# IDE
.vscode/
.idea/
.trae/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local
.mcp-url

# Reasonix
reasonix.toml

# WorkBuddy workspace metadata
.workbuddy/

# 记录现场 export (本地导出数据，含封面图片，不纳入仓库)
recordlive_export/
web/static/sw.js
outputs/
.zcode/

# ---- AI Agent 生成目录（不进版本库，本地保留）----
.workbuddy/
.trae/
.trea/
.qoder/
.opencode/
.cursor/
.claude/
.codex/
.gemini/
.continue/
