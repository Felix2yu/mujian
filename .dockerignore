# VCS / CI metadata
.git
.github

# Frontend source + tooling — assets are prebuilt and supplied as the
# `frontend-dist` artifact (extracted to ./dist at build context root).
frontend
node_modules

# Backend source is compiled by the CI `build` job; only the resulting
# binary is shipped into the image. The build context only needs `dist/`
# and `bin/`.
backend
backend/node_modules
backend/mujian
backend/data

# Large media / output dirs unrelated to the image
outputs
recordlive_export

# Docs and misc
docs
*.md
Makefile
pnpm-lock.yaml
package-lock.json

# Keep the prebuilt artifacts at the context root
!dist
!bin
